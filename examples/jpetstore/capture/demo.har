b3;q=0.7"}, {"name": "Accept-Encoding", "value": "gzip, deflate, br, zstd"}, {"name": "Cache-Control", "value": "max-age=0"}, {"name": "Connection", "value": "keep-alive"}, {"name": "Content-Length", "value": "242"}, {"name": "Content-Type", "value": "application/x-www-form-urlencoded"}, {"name": "Cookie", "value": "***"}, {"name": "Host", "value": "localhost:8080"}, {"name": "Origin", "value": "http://localhost:8080"}, {"name": "Referer", "value": "http://localhost:8080/jpetstore/order/new"}, {"name": "Sec-Fetch-Dest", "value": "document"}, {"name": "Sec-Fetch-Mode", "value": "navigate"}, {"name": "Sec-Fetch-Site", "value": "same-origin"}, {"name": "Sec-Fetch-User", "value": "?1"}, {"name": "Upgrade-Insecure-Requests", "value": "1"}, {"name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/140.0.7339.16 Safari/537.36"}, {"name": "sec-ch-ua", "value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"HeadlessChrome\";v=\"140\""}, {"name": "sec-ch-ua-mobile", "value": "?0"}, {"name": "sec-ch-ua-platform", "value": "\"Windows\""}, {"name": "x-automcp-step", "value": "UC-5/submit-order"}], "queryString": [], "headersSize": 936, "bodySize": 242, "postData": {"mimeType": "application/x-www-form-urlencoded", "text": "cardType=***&creditCard=***&expiryDate=***&billToFirstName=ABC&billToLastName=XYX&billAddress1=901+San+Antonio+Road&billAddress2=MS+UCUP02-206&billCity=Palo+Alto&billState=CA&billZip=94303&billCountry=USA&newOrder=Continue", "params": [{"name": "cardType", "value": "***"}, {"name": "creditCard", "value": "***"}, {"name": "expiryDate", "value": "***"}, {"name": "billToFirstName", "value": "ABC"}, {"name": "billToLastName", "value": "XYX"}, {"name": "billAddress1", "value": "901 San Antonio Road"}, {"name": "billAddress2", "value": "MS UCUP02-206"}, {"name": "billCity", "value": "Palo Alto"}, {"name": "billState", "value": "CA"}, {"name": "billZip", "value": "94303"}, {"name": "billCountry", "value": "USA"}, {"name": "newOrder", "value": "Continue"}]}}, "response": {"status": 200, "statusText": "", "httpVersion": "HTTP/1.1", "cookies": [], "headers": [{"name": "Connection", "value": "keep-alive"}, {"name": "Content-Language", "value": "en-US"}, {"name": "Content-Length", "value": "5795"}, {"name": "Content-Type", "value": "text/html;charset=UTF-8"}, {"name": "Date", "value": "Wed, 14 Oct 2026 14:42:53 GMT"}, {"name": "Keep-Alive", "value": "timeout=20"}], "content": {"size": 5795, "mimeType": "text/html;charset=UTF-8", "compression": 0, "text": "\r\n\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html>\r\n\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <link rel=\"StyleSheet\" href=\"/jpetstore/css/jpetstore.css\" type=\"text/css\" media=\"screen\" />\r\n    <meta name=\"generator\" content=\"HTML Tidy for Linux/x86 (vers 1st November 2002), see www.w3.org\" />\r\n    <title>JPetStore Demo</title>\r\n    <meta content=\"text/html; charset=windows-1252\" http-equiv=\"Content-Type\" />\r\n    <meta http-equiv=\"Cache-Control\" content=\"max-age=0\" />\r\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache\" />\r\n    <meta http-equiv=\"expires\" content=\"0\" />\r\n    <meta http-equiv=\"Expires\" content=\"Tue, 01 Jan 1980 1:00:00 GMT\" />\r\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\r\n</head>\r\n\r\n<body>\r\n\r\n    <div id=\"Header\">\r\n\r\n        <div id=\"Logo\">\r\n            <div id=\"LogoContent\"><a href=\"/jpetstore/catalog\"><img src=\"/jpetstore/images/logo-topbar.gif\" /></a></div>\r\n        </div>\r\n\r\n        <div id=\"Menu\">\r\n            <div id=\"MenuContent\">\r\n                <a href=\"/jpetstore/cart\"><img align=\"middle\" name=\"img_cart\" src=\"/jpetstore/images/cart.gif\" /></a>\r\n                <img align=\"middle\" src=\"/jpetstore/images/separator.gif\" />\r\n                \r\n                    \r\n                    \r\n                        <a href=\"/jpetstore/account/signoff\">Sign Out</a>\r\n                        <img align=\"middle\" src=\"/jpetstore/images/separator.gif\" />\r\n                        <a href=\"/jpetstore/account/edit\">My Account</a>\r\n                    \r\n                \r\n                <img align=\"middle\" src=\"/jpetstore/images/separator.gif\" />\r\n                <a href=\"/jpetstore/help.html\">?</a>\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"Search\">\r\n            <div id=\"SearchContent\">\r\n                <form method=\"get\" action=\"/jpetstore/catalog/searchProducts\">\r\n                    <input type=\"text\" name=\"keyword\" size=\"14\" />\r\n                    <input type=\"submit\" name=\"searchProducts\" value=\"Search\" />\r\n                </form>\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"QuickLinks\">\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=FISH\"><img src=\"/jpetstore/images/sm_fish.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=DOGS\"><img src=\"/jpetstore/images/sm_dogs.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=REPTILES\"><img src=\"/jpetstore/images/sm_reptiles.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=CATS\"><img src=\"/jpetstore/images/sm_cats.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=BIRDS\"><img src=\"/jpetstore/images/sm_birds.gif\" /></a>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <div id=\"Content\">\r\n        \r\n\r\n\r\n<div id=\"BackLink\"><a href=\"/jpetstore/catalog\">Return to Main Menu</a></div>\r\n\r\n    <div id=\"Catalog\">Please confirm the information below and then press continue...\r\n\r\n        <table>\r\n            <tr>\r\n                <th align=\"center\" colspan=\"2\">\r\n                    <font size=\"4\"><b>Order</b></font>\r\n                    <br />\r\n                    <font size=\"3\"><b>2026/10/14 14:42:53</b></font>\r\n                </th>\r\n            </tr>\r\n\r\n            <tr>\r\n                <th colspan=\"2\">Billing Address</th>\r\n            </tr>\r\n            <tr>\r\n                <td>First name:</td>\r\n                <td>ABC</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Last name:</td>\r\n                <td>XYX</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Address 1:</td>\r\n                <td>901 San Antonio Road</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Address 2:</td>\r\n                <td>MS UCUP02-206</td>\r\n            </tr>\r\n            <tr>\r\n                <td>City:</td>\r\n                <td>Palo Alto</td>\r\n            </tr>\r\n            <tr>\r\n                <td>State:</td>\r\n                <td>CA</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Zip:</td>\r\n                <td>94303</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Country:</td>\r\n                <td>USA</td>\r\n            </tr>\r\n            <tr>\r\n                <th colspan=\"2\">Shipping Address</th>\r\n            </tr>\r\n            <tr>\r\n                <td>First name:</td>\r\n                <td>ABC</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Last name:</td>\r\n                <td>XYX</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Address 1:</td>\r\n                <td>901 San Antonio Road</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Address 2:</td>\r\n                <td>MS UCUP02-206</td>\r\n            </tr>\r\n            <tr>\r\n                <td>City:</td>\r\n                <td>Palo Alto</td>\r\n            </tr>\r\n            <tr>\r\n                <td>State:</td>\r\n                <td>CA</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Zip:</td>\r\n                <td>94303</td>\r\n            </tr>\r\n            <tr>\r\n                <td>Country:</td>\r\n                <td>USA</td>\r\n            </tr>\r\n\r\n        </table>\r\n\r\n        <form method=\"post\" action=\"/jpetstore/order/new\">\r\n            <input type=\"hidden\" name=\"confirmed\" value=\"true\" />\r\n            <input type=\"submit\" class=\"Button\" value=\"Confirm\" />\r\n        </form>\r\n    </div>\r\n\r\n\r\n</div>\r\n\r\n<div id=\"Footer\">\r\n\r\n<div id=\"PoweredBy\">&nbsp;<a href=\"http://www.mybatis.org\">www.mybatis.org</a>\r\n</div>\r\n\r\n<div id=\"Banner\">\r\n\t\r\n\t\t\r\n          <image src=\"/jpetstore/images/banner_dogs.gif\">\r\n        \r\n\t\r\n</div>\r\n\r\n</div>\r\n\r\n</body>\r\n</html>\r\n\r\n"}, "headersSize": 187, "bodySize": 5796, "redirectURL": "", "_transferSize": 5983}, "cache": {}, "timings": {"dns": -1, "connect": -1, "ssl": -1, "send": 0, "wait": 50.123, "receive": 0.442}, "pageref": "page@ee950c39898ffb730146256aa605a631", "serverIPAddress": "[::1]", "_serverPort": 8080, "_securityDetails": {}}, {"startedDateTime": "2026-10-14T14:42:55.131Z", "time": 1.067, "request": {"method": "GET", "url": "http://localhost:8080/jpetstore/css/jpetstore.css", "httpVersion": "HTTP/1.1", "cookies": [], "headers": [{"name": "sec-ch-ua-platform", "value": "\"Windows\""}, {"name": "Referer", "value": "http://localhost:8080/jpetstore/order/new"}, {"name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/140.0.7339.16 Safari/537.36"}, {"name": "sec-ch-ua", "value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"HeadlessChrome\";v=\"140\""}, {"name": "x-automcp-step", "value": "UC-5/submit-order"}, {"name": "sec-ch-ua-mobile", "value": "?0"}], "queryString": [], "headersSize": 399, "bodySize"