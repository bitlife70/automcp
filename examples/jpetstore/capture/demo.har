ut=20"}, {"name": "Set-Cookie", "value": "***"}], "content": {"size": 5104, "mimeType": "text/html;charset=UTF-8", "compression": 0, "text": "\r\n\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html>\r\n\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <link rel=\"StyleSheet\" href=\"/jpetstore/css/jpetstore.css\" type=\"text/css\" media=\"screen\" />\r\n    <meta name=\"generator\" content=\"HTML Tidy for Linux/x86 (vers 1st November 2002), see www.w3.org\" />\r\n    <title>JPetStore Demo</title>\r\n    <meta content=\"text/html; charset=windows-1252\" http-equiv=\"Content-Type\" />\r\n    <meta http-equiv=\"Cache-Control\" content=\"max-age=0\" />\r\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache\" />\r\n    <meta http-equiv=\"expires\" content=\"0\" />\r\n    <meta http-equiv=\"Expires\" content=\"Tue, 01 Jan 1980 1:00:00 GMT\" />\r\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\r\n</head>\r\n\r\n<body>\r\n\r\n    <div id=\"Header\">\r\n\r\n        <div id=\"Logo\">\r\n            <div id=\"LogoContent\"><a href=\"/jpetstore/catalog\"><img src=\"/jpetstore/images/logo-topbar.gif\" /></a></div>\r\n        </div>\r\n\r\n        <div id=\"Menu\">\r\n            <div id=\"MenuContent\">\r\n                <a href=\"/jpetstore/cart\"><img align=\"middle\" name=\"img_cart\" src=\"/jpetstore/images/cart.gif\" /></a>\r\n                <img align=\"middle\" src=\"/jpetstore/images/separator.gif\" />\r\n                \r\n                    \r\n                        <a href=\"/jpetstore/account\">Sign In</a>\r\n                    \r\n                    \r\n                \r\n                <img align=\"middle\" src=\"/jpetstore/images/separator.gif\" />\r\n                <a href=\"/jpetstore/help.html\">?</a>\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"Search\">\r\n            <div id=\"SearchContent\">\r\n                <form method=\"get\" action=\"/jpetstore/catalog/searchProducts\">\r\n                    <input type=\"text\" name=\"keyword\" size=\"14\" />\r\n                    <input type=\"submit\" name=\"searchProducts\" value=\"Search\" />\r\n                </form>\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"QuickLinks\">\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=FISH\"><img src=\"/jpetstore/images/sm_fish.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=DOGS\"><img src=\"/jpetstore/images/sm_dogs.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=REPTILES\"><img src=\"/jpetstore/images/sm_reptiles.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=CATS\"><img src=\"/jpetstore/images/sm_cats.gif\" /></a>\r\n            <img src=\"/jpetstore/images/separator.gif\" />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=BIRDS\"><img src=\"/jpetstore/images/sm_birds.gif\" /></a>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <div id=\"Content\">\r\n        \r\n\r\n\r\n<div id=\"Welcome\">\r\n    <div id=\"WelcomeContent\">\r\n        \r\n    </div>\r\n</div>\r\n\r\n<div id=\"Main\">\r\n    <div id=\"Sidebar\">\r\n        <div id=\"SidebarContent\">\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=FISH\"><img src=\"/jpetstore/images/fish_icon.gif\" /></a> <br />\r\n            Saltwater, Freshwater <br />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=DOGS\"><img src=\"/jpetstore/images/dogs_icon.gif\" /></a> <br />\r\n            Various Breeds <br />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=CATS\"><img src=\"/jpetstore/images/cats_icon.gif\" /></a> <br />\r\n            Various Breeds, Exotic Varieties <br />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=REPTILES\"><img src=\"/jpetstore/images/reptiles_icon.gif\" /></a> <br />\r\n            Lizards, Turtles, Snakes <br />\r\n            <a href=\"/jpetstore/catalog/viewCategory?categoryId=BIRDS\"><img src=\"/jpetstore/images/birds_icon.gif\" /></a> <br />\r\n            Exotic Varieties\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"MainImage\">\r\n        <div id=\"MainImageContent\">\r\n            <map name=\"estoremap\">\r\n                <area alt=\"Birds\" coords=\"72,2,280,250\" href=\"/jpetstore/catalog/viewCategory?categoryId=BIRDS\" shape=\"RECT\" />\r\n                <area alt=\"Fish\" coords=\"2,180,72,250\" href=\"/jpetstore/catalog/viewCategory?categoryId=FISH\" shape=\"RECT\" />\r\n                <area alt=\"Dogs\" coords=\"60,250,130,320\" href=\"/jpetstore/catalog/viewCategory?categoryId=DOGS\" shape=\"RECT\" />\r\n                <area alt=\"Reptiles\" coords=\"140,270,210,340\" href=\"/jpetstore/catalog/viewCategory?categoryId=REPTILES\" shape=\"RECT\" />\r\n                <area alt=\"Cats\" coords=\"225,240,295,310\" href=\"/jpetstore/catalog/viewCategory?categoryId=CATS\" shape=\"RECT\" />\r\n                <area alt=\"Birds\" coords=\"280,180,350,250\" href=\"/jpetstore/catalog/viewCategory?categoryId=BIRDS\" shape=\"RECT\" />\r\n            </map>\r\n            <img height=\"355\" src=\"/jpetstore/images/splash.gif\" align=\"middle\" usemap=\"#estoremap\" width=\"350\" />\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"Separator\">&nbsp;</div>\r\n</div>\r\n\r\n\r\n</div>\r\n\r\n<div id=\"Footer\">\r\n\r\n<div id=\"PoweredBy\">&nbsp;<a href=\"http://www.mybatis.org\">www.mybatis.org</a>\r\n</div>\r\n\r\n<div id=\"Banner\"></div>\r\n\r\n</div>\r\n\r\n</body>\r\n</html>\r\n\r\n"}, "headersSize": 271, "bodySize": 5105, "redirectURL": "", "_transferSize": 5376}, "cache": {}, "timings": {"dns": 0.005, "connect": 0.615, "ssl": 4.092, "send": 0, "wait": 5.096, "receive": 1.521}, "pageref": "page@ee950c39898ffb730146256aa605a631", "serverIPAddress": "[